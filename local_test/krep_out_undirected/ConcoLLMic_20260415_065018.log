        temp_file.write(file_data)
        temp_file.flush()
        temp_file_path = temp_file.name
        try:
            result = subprocess.run(
                ["./krep", "-o", "test", temp_file_path],
                capture_output=True,
                encoding="utf-8",
                errors="replace",
