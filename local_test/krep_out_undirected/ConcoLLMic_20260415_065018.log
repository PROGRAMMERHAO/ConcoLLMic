    # Pattern: "ab" (simple, valid pattern)
    pattern = "ab"
    
    # Stdin data: some test content
    stdin_data = "ab\ntest\nab\n"
    
    try:
        # Command: ./krep -c -i "ab" -
        # The "-" argument tells the program to read from stdin
        # -c flag enables count mode (optional)
