import struct

def float_to_bits(f):
    """Convert a float to its bit representation as an unsigned integer."""
    return struct.unpack('>I', struct.pack('>f', f))[0]

def bits_to_float(bits):
    """Convert an unsigned integer bit representation to a float."""
    return struct.unpack('>f', struct.pack('>I', bits))[0]

def next_float(f):
    """Get the next representable single-precision float after f."""
    bits = float_to_bits(f)
    return bits_to_float(bits + 1)

# Start with 1.0
start = 1.0
print(f"Start: {start}")
print(f"Start bits: {float_to_bits(start):032b} ({float_to_bits(start)})")

# Find the 20th float after 1.0 (which would give count = 20)
