import struct

def float_to_bits(f):
    """Convert float to its unsigned integer bit representation"""
    return struct.unpack('>I', struct.pack('>f', f))[0]

def bits_to_float(bits):
    """Convert unsigned integer bits to float"""
    return struct.unpack('>f', struct.pack('>I', bits))[0]

# Start with 1.0
start = 1.0
start_bits = float_to_bits(start)
print(f"1.0 in bits: {start_bits:#010x}")

# Calculate the next 25 floats after 1.0
print("\nNext floats after 1.0:")
for i in range(1, 26):
    next_bits = start_bits + i
    next_float = bits_to_float(next_bits)
    print(f"  +{i} ULP: {next_float:.20f}")

# For count <= 20, we need at most 20 floats in [start, end)
# If start = 1.0 and end is 20 ULPs away, we get exactly 20 floats
end_20 = bits_to_float(start_bits + 20)
print(f"\n20 ULPs from 1.0: {end_20:.20f}")
print(f"Is {end_20} <= 1.00001? {end_20 <= 1.00001}")

# Let's also check what 1.00001 is in terms of ULPs from 1.0
end_limit = 1.00001
end_limit_bits = float_to_bits(end_limit)
ulp_diff = end_limit_bits - start_bits
print(f"\n1.00001 is {ulp_diff} ULPs from 1.0")

