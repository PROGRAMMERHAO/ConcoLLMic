import struct

def bits_to_float(bits):
    """Convert unsigned int bit representation to float"""
    return struct.unpack('>f', struct.pack('>I', bits))[0]

def float_to_bits(f):
    """Convert float to its bit representation as unsigned int"""
    return struct.unpack('>I', struct.pack('>f', f))[0]

# Simulate the counting logic from the C program
def count_floats_between(start, end):
    """Count floats in [start, end) by incrementing bit patterns"""
    count = 0
    current = start
    
    while current < end:
        count += 1
        # Increment the bit pattern
        current_bits = float_to_bits(current)
        next_bits = current_bits + 1
        current = bits_to_float(next_bits)
        
        # Safety check to avoid infinite loop
        if count > 1000:
            print("Safety limit reached!")
            break
    
    return count

# Test with our values
