# Let me verify the float representation and count logic
import struct

def float_to_bits(f):
    """Convert float to its bit representation as unsigned int"""
    return struct.unpack('>I', struct.pack('>f', f))[0]

def bits_to_float(bits):
    """Convert unsigned int bits back to float"""
    return struct.unpack('>f', struct.pack('>I', bits))[0]

def count_floats_between(start, end):
    """Count single-precision floats from start (inclusive) to end (exclusive)"""
    count = 0
    current = start
    while current < end:
        count += 1
        # Increment at bit level
        bits = float_to_bits(current)
        bits += 1
        current = bits_to_float(bits)
        # Safety check to avoid infinite loop
        if count > 1000000:
            return "Too many (>1M)"
    return count

# Test case 1: start = end = 1.0
print(f"Case 1: start=1.0, end=1.0")
print(f"Count: {count_floats_between(1.0, 1.0)}")
print()

# Test case 2: original values
print(f"Case 2: start=1.0, end=1.00001")
print(f"Count: {count_floats_between(1.0, 1.00001)}")
print()

# Test case 3: consecutive floats
start = 1.0
bits = float_to_bits(start)
next_float = bits_to_float(bits + 1)
print(f"Case 3: start=1.0, end={next_float} (next representable float)")
print(f"Count: {count_floats_between(1.0, next_float)}")
print()

# Test case 4: 20 floats apart
start = 1.0
bits = float_to_bits(start)
end_20 = bits_to_float(bits + 20)
