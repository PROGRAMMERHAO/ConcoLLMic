print(f"end = {end}")
print(f"start bits = 0x{float_to_bits(start):08X}")
print(f"end bits = 0x{float_to_bits(end):08X}")
print(f"Bit difference = {float_to_bits(end) - float_to_bits(start)}")

count = count_floats_between(start, end)
print(f"\nCount of floats in [start, end) = {count}")
print(f"count <= 20? {count <= 20}")

# Also test with exactly 20 ULPs to see if count is 20
print("\n--- Testing different ULP distances ---")
for ulp_dist in [19, 20, 21]:
