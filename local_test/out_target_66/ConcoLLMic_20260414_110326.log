import struct

def float_to_bits(f):
    """Convert float to its bit representation as unsigned int"""
    return struct.unpack('>I', struct.pack('>f', f))[0]

def bits_to_float(bits):
    """Convert unsigned int bit representation to float"""
    return struct.unpack('>f', struct.pack('>I', bits))[0]

def next_float(f, n=1):
    """Get the nth next representable float after f"""
    bits = float_to_bits(f)
    return bits_to_float(bits + n)

# Calculate floats around 1.0
start = 1.0
start_bits = float_to_bits(start)

# Get the 20th next float from 1.0
end_20 = next_float(start, 20)
end_20_bits = float_to_bits(end_20)

