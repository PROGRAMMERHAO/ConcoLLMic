import struct
import numpy as np

# Convert float to its unsigned 32-bit integer representation
def float_to_uint(f):
    return struct.unpack('>I', struct.pack('>f', f))[0]

# Convert unsigned 32-bit integer to float
def uint_to_float(i):
    return struct.unpack('>f', struct.pack('>I', i))[0]

# Count floats between start (inclusive) and end (exclusive)
def count_floats_between(start, end):
    if start >= end:
        return 0
    
    start_uint = float_to_uint(start)
    end_uint = float_to_uint(end)
    
    count = 0
    current_uint = start_uint
    current_float = start
    
    while current_float < end and count < 1000:  # safety limit
        count += 1
        current_uint += 1
        current_float = uint_to_float(current_uint)
    
    return count

# Test the original values
start1 = 1.0
end1 = 1.00001
count1 = count_floats_between(start1, end1)
print(f"Original: start={start1}, end={end1}, count={count1}")

# Now find values that give count <= 20
# Start with 1.0 and find the 20th next float
start2 = np.float32(1.0)
start_uint = float_to_uint(start2)

# Get the float that is 20 ULPs away
end_uint_20 = start_uint + 20
end2 = uint_to_float(end_uint_20)

count2 = count_floats_between(start2, end2)
print(f"\nWith 20 ULPs: start={start2}, end={end2}, count={count2}")
print(f"end2 in hex: {end2.hex()}")
print(f"end2 precise: {end2:.20f}")

# Also try with exactly 20 floats (count should be 20)
end_uint_19 = start_uint + 19
end3 = uint_to_float(end_uint_19)
count3 = count_floats_between(start2, end3)
print(f"\nWith 19 ULPs: start={start2}, end={end3}, count={count3}")

# Try with 10 floats
end_uint_10 = start_uint + 10
end4 = uint_to_float(end_uint_10)
count4 = count_floats_between(start2, end4)
print(f"\nWith 10 ULPs: start={start2}, end={end4}, count={count4}")
print(f"end4 precise: {end4:.20f}")

# Check constraints
print(f"\nChecking constraints for count=20 case:")
print(f"start <= end: {start2 <= end2}")
print(f"start >= 1.0: {start2 >= 1.0}")
print(f"end <= 1.00001: {end2 <= 1.00001}")
print(f"count <= 20: {count2 <= 20}")

